<RCC>
    <qresource prefix="/styles">
        <file alias="theme.qss">theme.qss</file>
    </qresource>
    <qresource prefix="/skins/dark">
        <file alias="theme.json">skins/dark/theme.json</file>
    </qresource>
    <qresource prefix="/skins/light">
        <file alias="theme.json">skins/light/theme.json</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="Logo_rounded.png">images/Logo_rounded.png</file>
        <file alias="Logo_nb.png">images/Logo_nb.png</file>
        <file alias="Logo.png">images/Logo.png</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="RedHatMono-Regular.ttf">fonts/RedHatMono-Regular.ttf</file>
        <file alias="Workbench-Regular.ttf">fonts/Workbench-Regular.ttf</file>
    </qresource>
    <qresource prefix="/map">
        <file alias="map3d.html">map/map3d.html</file>
        <file alias="map3d.css">map/map3d.css</file>
        <file alias="map3d.js">map/map3d.js</file>
        <file alias="leaflet.js">map/leaflet.js</file>
        <file alias="leaflet.css">map/leaflet.css</file>
        <file alias="leaflet.LICENSE">map/leaflet.LICENSE</file>
        <file alias="vendor/three/LICENSE">map/vendor/three/LICENSE</file>
        <file alias="vendor/three/build/three.module.js">map/vendor/three/build/three.module.js</file>
        <file alias="vendor/three/examples/jsm/controls/OrbitControls.js">map/vendor/three/examples/jsm/controls/OrbitControls.js</file>
        <file alias="vendor/three/examples/jsm/lines/Line2.js">map/vendor/three/examples/jsm/lines/Line2.js</file>
        <file alias="vendor/three/examples/jsm/lines/LineGeometry.js">map/vendor/three/examples/jsm/lines/LineGeometry.js</file>
        <file alias="vendor/three/examples/jsm/lines/LineMaterial.js">map/vendor/three/examples/jsm/lines/LineMaterial.js</file>
        <file alias="vendor/three/examples/jsm/lines/LineSegments2.js">map/vendor/three/examples/jsm/lines/LineSegments2.js</file>
        <file alias="vendor/three/examples/jsm/lines/LineSegmentsGeometry.js">map/vendor/three/examples/jsm/lines/LineSegmentsGeometry.js</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="settings_button.png">icons/settings_button.png</file>
        <file alias="settings_button_black.png">icons/settings_button_black.png</file>
    </qresource>
</RCC>
